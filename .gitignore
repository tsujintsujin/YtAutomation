# third-party clones with their own git (opencut-controller holds local changes: see HANDOFF)
opencut-classic/
opencut-controller/

# Python, models, local state
tts/.venv/
tts/models/
tts/samples/
__pycache__/
.claude/
dashboard-cache/
usage.jsonl
.test30.txt
test-assets/

# output: keep each video's story, prompts, timings and reference sheets; media stays local
output/*
!output/*/
output/_*/
output/*/*
!output/*/*.py
!output/*/*.md
!output/*/script.json
!output/*/segments.json
!output/*/timings.json
!output/*/voice-settings.json
!output/*/thumb-ideas.json
!output/*/thumbnails.json
!output/*/intro.json
!output/*/*.srt
!output/*/refs/

# taskbar shortcut: holds paths of this PC (made by hand, see HANDOFF)
*.lnk

# HyperFrames intro/outro projects: keep sources and intro-outro/final/ (used by every render), not scratch renders
intro-outro/*/renders/
intro-outro/*/snapshots/
intro-outro/*/.media/
intro-outro/render-*.log
intro-outro/*/.hyperframes/
intro-outro/*/.thumbnails/
intro-outro/*/.waveform-cache/
bridge.log
tts/voiceover.log

# Chatterbox page: venv, voice recordings (refs/ holds Justin's own voice) and test clips stay local
chatterbox/.venv/
chatterbox/refs/
chatterbox/out*/
chatterbox/app.log

# short channels: same as output/ (each video's story, prompts, timings and refs in git; media stays local)
channels/*/videos/*/*
!channels/*/videos/*/*.py
!channels/*/videos/*/*.md
!channels/*/videos/*/script.json
!channels/*/videos/*/timings.json
!channels/*/videos/*/voice-settings.json
!channels/*/videos/*/*.srt
!channels/*/videos/*/refs/

# short channels: weekly source transcripts are other creators' words (research only), never committed
channels/*/weeks/
